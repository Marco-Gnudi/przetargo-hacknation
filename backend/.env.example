# Copy to backend/.env, or export these in the shell. Never commit a real key.
# Only the key is needed: the endpoint and model below are the defaults.
# MISTRAL_API_KEY (or LLM_API_KEY) enables hybrid mode; leave it empty for deterministic mode.
MISTRAL_API_KEY=

# Mistral Small 3.2 (Apache 2.0) on Scaleway Generative APIs, served from Paris (EU).
MISTRAL_BASE_URL=https://api.scaleway.ai/v1
MISTRAL_MODEL=mistral-small-3.2-24b-instruct-2506

# Alternative: Mistral's own EU endpoint. Small 3.2 is retired there; Small 4 (Apache 2.0) replaces it.
# MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-2603

# Full path to tesseract when it is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
